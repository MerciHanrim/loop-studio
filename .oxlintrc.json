{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  // issue #625 item 5 (Lumi, 2026-11-27): a correctness rule is an error, so a
  // planted bug fails `npm run lint`. The correctness rules below had warnings
  // in the code on 2026-11-27 (58 in all, seven rules) and stay warnings until
  // each is fixed rule by rule and moved up to an error; `npm run lint` also
  // fails above the warnings left (`--max-warnings`), so none of them can grow.
  // Moved up so far: eslint/no-unused-vars (1) and
  // eslint/no-unsafe-optional-chaining (5), fixed in the first follow-up;
  // react/use-memo (1) and react/immutability (2), in the second.
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // the correctness rules with warnings on 2026-11-27, and how many
    "react/set-state-in-effect": "warn", // 23, then 21 (the overflow menu and the run-rule draft reset during render), then 20 (View's open row)
    "react/refs": "warn", // 15, then 13 (Canvas's initial view is an effect event), then 8 (RouteBends' and FrameLayer's key gestures and the frame chip), then 6 (the Timeline area's most from the column's observed height), then 0 in view (LoopEdge's badge place held in state); the one under a suppression comment remains, so it stays a warning
    // 11, then 7 (4 fixed in the charts and LoopEdge), then 1 (6 in Canvas), then 0 in view
    // (TimelineChart's floor); the ones under suppression comments remain, so it stays a warning
    "react-hooks/exhaustive-deps": "warn"
  }
}
