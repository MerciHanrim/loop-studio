{
  "name": "loop-studio",
  "private": true,
  "version": "0.17.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-no-pseudo-locales.mjs dist",
    "build:portable": "tsc -b && vite build --mode portable && node scripts/check-no-pseudo-locales.mjs dist-portable",
    "build:pwa": "tsc -b && vite build --mode pwa && node scripts/check-no-pseudo-locales.mjs dist-pwa",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:known-labels": "node scripts/gen-known-labels.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:mobile-query": "node scripts/check-mobile-query.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-surface": "node scripts/check-i18n-surface.mjs",
    "check:template-labels": "node scripts/check-template-labels.mjs",
    "check:no-pwa": "node scripts/check-no-pwa.mjs",
    "check:no-pseudo-locales": "node scripts/check-no-pseudo-locales.mjs --all",
    "check:pwa-closure": "node scripts/check-pwa-closure.mjs",
    "check:csv-boundary": "node scripts/check-csv-boundary.mjs",
    "check:form-direction": "node scripts/check-form-direction.mjs",
    "check:direction-props": "node scripts/check-direction-props.mjs",
    "check:content-direction": "node scripts/check-content-direction.mjs",
    "check:arrow-direction": "node scripts/check-arrow-direction.mjs",
    "check:isolate-arguments": "node scripts/check-isolate-arguments.mjs",
    "check:icu-arguments": "node scripts/check-icu-arguments.mjs",
    "check:control-bytes": "node scripts/check-control-bytes.mjs",
    "check:locale-lists": "node scripts/check-locale-lists.mjs",
    "check:snapshot-policy": "node scripts/check-snapshot-policy.mjs",
    "check:storage-port": "node scripts/check-storage-port.mjs",
    "check:share-crypto": "node scripts/check-share-crypto.mjs",
    "check:change-declaration": "node scripts/check-change-declaration.mjs",
    "check:e2e-shards": "node scripts/e2e-shards.mjs check",
    "check:functional-glyphs": "node scripts/check-functional-glyphs.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --port 4173 --strictPort",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:dist": "playwright test -c playwright.dist.config.ts",
    "e2e:pwa": "playwright test -c playwright.pwa.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@noble/hashes": "2.4.0",
    "@xyflow/react": "^12.11.5",
    "intl-messageformat": "11.2.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
