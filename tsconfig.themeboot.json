{
  // `src/storage/themeBoot.js` — the classic script vite.config.ts inlines into
  // the <head> of every build, before the bundle. It cannot be TypeScript (it is
  // never transpiled), so it is type-checked as JavaScript here (issue #624:
  // until this project, no `tsc` run read it). DOM types only: it runs in the
  // page, before any module.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.themeboot.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": ["src/storage/themeBoot.js"]
}
