{
  // The TypeScript tests beside the node scripts (`scripts/*.test.ts`). Vitest
  // only TRANSPILES them; without this project `tsc -b` never type-checked
  // them (#424, 2026-11-01: two type errors in example-columns.test.ts had
  // gone unseen). The scripts themselves are `.mjs` and stay outside.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode — same as tsconfig.app.json */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* the tests import the `.mjs` scripts: read their types from the JS
       (inferred), without type-checking the scripts themselves (no checkJs) */
    "allowJs": true,

    /* Linting — same as the other projects */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts/**/*.ts"]
}
