{
  // The Playwright specs, their support helpers and the Playwright configs.
  // Playwright only TRANSPILES these; without this project `tsc -b` never
  // type-checked them (found 2026-09-19: five `test.use({ reducedMotion })`
  // calls that Playwright silently ignored were invisible to the build).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    // DOM for the `page.evaluate` callbacks, node for the runner side
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode — same as tsconfig.app.json */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* `await import('/src/…')` inside page.evaluate is a Vite root-absolute
       module URL resolved by the dev server; map it so the same string is a
       typed import here (the product file is checked under these options too). */
    "paths": { "/src/*": ["./src/*"] },

    /* Linting — same as the other projects */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts", "playwright.dist.config.ts", "playwright.pwa.config.ts"]
}
